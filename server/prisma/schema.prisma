generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  admin
  field_agent
  community_user
}

enum SensorType {
  GROUNDWATER
  SOIL_MOISTURE
  RAINFALL
  WEATHER
}

enum SensorStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum DroughtRiskLevel {
  NORMAL
  WATCH
  WARNING
  EMERGENCY
}

enum SatelliteIndexType {
  NDVI
  LST
  SMAP
  ET
}

enum AlertSeverity {
  WATCH
  WARNING
  EMERGENCY
}

enum ReportStatus {
  PENDING
  VERIFIED
  REJECTED
  RESOLVED
}

enum BoreholeStatus {
  FUNCTIONAL
  DRY
  ABANDONED
}

enum HydroEventType {
  FLASH_FLOOD
  DROUGHT
}

enum ReportSource {
  MOBILE_APP
  OFFLINE_SYNC
  IVR
  WHATSAPP
}

enum MaintenanceTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model Tenant {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  country     String
  createdAt   DateTime  @default(now())
  users       User[]
  districts   District[]
  apiKeys     ApiKey[]
  simulations DigitalTwinSimulation[]
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String?           @db.Uuid
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name             String
  email            String            @unique
  passwordHash     String
  role             UserRole          @default(community_user)
  district         String?
  points           Int               @default(0)
  createdAt        DateTime          @default(now())
  communityReports CommunityReport[]

  @@index([tenantId])
  @@index([role])
  @@index([district])
}

model District {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String?            @db.Uuid
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name              String             @unique
  geometry          Unsupported("geometry(Polygon, 4326)")
  droughtRiskLevel  DroughtRiskLevel   @default(NORMAL)
  createdAt         DateTime           @default(now())
  sensors           Sensor[]
  satelliteIndexes  SatelliteIndex[]
  droughtAlerts     DroughtAlert[]
  communityReports  CommunityReport[]
  droughtForecasts  DroughtForecast[]
  droughtSnapshots  DroughtSnapshot[]
  boreholes         Borehole[]
  hydroEvents       HydroEvent[]

  @@index([tenantId])
  @@index([droughtRiskLevel])
}

model DroughtSnapshot {
  id                     String           @id @default(uuid()) @db.Uuid
  districtId             String           @db.Uuid
  district               District         @relation(fields: [districtId], references: [id], onDelete: Cascade)
  weekStart              DateTime
  severityScore          Float
  riskLevel              DroughtRiskLevel
  groundwaterDepthMeters Float
  rainfallAnomalyPercent Float
  ndvi                   Float

  @@index([districtId, weekStart])
  @@index([riskLevel])
}

model Borehole {
  id                  String         @id @default(uuid()) @db.Uuid
  name                String
  location            Unsupported("geometry(Point, 4326)")
  districtId          String         @db.Uuid
  district            District       @relation(fields: [districtId], references: [id], onDelete: Cascade)
  depthMeters         Float
  yieldLitersPerHour  Float
  status              BoreholeStatus
  lastInspectedAt     DateTime?

  @@index([districtId, status])
}

model ConflictRiskArea {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  geometry          Unsupported("geometry(Polygon, 4326)")
  riskScore         Float
  incidentsLastYear Int
  notes             String
  updatedAt         DateTime @default(now())

  @@index([riskScore])
}

model HydroEvent {
  id         String         @id @default(uuid()) @db.Uuid
  districtId String         @db.Uuid
  district   District       @relation(fields: [districtId], references: [id], onDelete: Cascade)
  eventType  HydroEventType
  severity   DroughtRiskLevel
  eventDate  DateTime
  geometry   Unsupported("geometry(Polygon, 4326)")
  notes      String

  @@index([districtId, eventType, eventDate])
}

model Sensor {
  id             String          @id @default(uuid()) @db.Uuid
  type           SensorType
  location       Unsupported("geometry(Point, 4326)")
  districtId     String          @db.Uuid
  district       District        @relation(fields: [districtId], references: [id], onDelete: Cascade)
  status         SensorStatus    @default(ONLINE)
  lastPing       DateTime?
  readings       SensorReading[]
  maintenanceTickets MaintenanceTicket[]

  @@index([type])
  @@index([districtId])
  @@index([status])
}

model MaintenanceTicket {
  id          String                  @id @default(uuid()) @db.Uuid
  sensorId    String                  @db.Uuid
  sensor      Sensor                  @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  districtId  String                  @db.Uuid
  title       String
  description String
  priority    MaintenancePriority     @default(MEDIUM)
  status      MaintenanceTicketStatus @default(OPEN)
  staleHours  Float
  assignedTo  String?
  createdAt   DateTime                @default(now())
  resolvedAt  DateTime?

  @@index([sensorId, status])
  @@index([districtId, status])
}

model DigitalTwinSimulation {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String?          @db.Uuid
  tenant                Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  districtId            String           @db.Uuid
  scenarioName          String
  rainfallDropPercent   Float
  durationWeeks         Int
  baselineGroundwater   Float
  projectedGroundwater  Float
  projectedSeverityScore Float
  projectedRiskLevel    DroughtRiskLevel
  assumptions           Json
  createdAt             DateTime         @default(now())

  @@index([tenantId, districtId, createdAt])
}

model ApiKey {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String?      @db.Uuid
  tenant          Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name            String
  keyHash         String       @unique
  keyPrefix       String
  ownerEmail      String
  quotaPerHour    Int          @default(100)
  status          ApiKeyStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  lastUsedAt      DateTime?
  usages          ApiUsage[]

  @@index([tenantId, status])
}

model ApiUsage {
  id        String   @id @default(uuid()) @db.Uuid
  apiKeyId  String   @db.Uuid
  apiKey    ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  route     String
  usedAt    DateTime @default(now())

  @@index([apiKeyId, usedAt])
}

model SensorReading {
  id        String   @id @default(uuid()) @db.Uuid
  sensorId  String   @db.Uuid
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  value     Float
  unit      String
  timestamp DateTime @default(now())
  metadata  Json?

  @@index([sensorId, timestamp])
}

model SatelliteIndex {
  id         String             @id @default(uuid()) @db.Uuid
  districtId String             @db.Uuid
  district   District           @relation(fields: [districtId], references: [id], onDelete: Cascade)
  indexType  SatelliteIndexType
  value      Float
  capturedAt DateTime
  geoTiff    String?

  @@index([districtId, indexType, capturedAt])
}

model DroughtAlert {
  id          String        @id @default(uuid()) @db.Uuid
  districtId  String        @db.Uuid
  district    District      @relation(fields: [districtId], references: [id], onDelete: Cascade)
  severity    AlertSeverity
  message     String
  triggeredAt DateTime      @default(now())
  resolvedAt  DateTime?

  @@index([districtId, resolvedAt])
  @@index([severity])
}

model CommunityReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  districtId  String?      @db.Uuid
  district    District?    @relation(fields: [districtId], references: [id], onDelete: SetNull)
  location    Unsupported("geometry(Point, 4326)")
  waterLevel  Float
  description String
  photoUrl    String?
  photoMetadata Json?
  gpsAccuracyMeters Float?
  source      ReportSource @default(MOBILE_APP)
  externalReporterPhone String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@index([userId])
  @@index([districtId, status])
}

model DroughtForecast {
  id                String           @id @default(uuid()) @db.Uuid
  districtId        String           @db.Uuid
  district          District         @relation(fields: [districtId], references: [id], onDelete: Cascade)
  forecastDate      DateTime
  predictedSeverity DroughtRiskLevel
  confidenceScore   Float
  modelVersion      String

  @@index([districtId, forecastDate])
}
