generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  admin
  field_agent
  community_user
}

enum AdminScope {
  PLATFORM
  TENANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SensorType {
  GROUNDWATER
  SOIL_MOISTURE
  RAINFALL
  WEATHER
}

enum SensorStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum DroughtRiskLevel {
  NORMAL
  WATCH
  WARNING
  EMERGENCY
}

enum SatelliteIndexType {
  NDVI
  LST
  SMAP
  ET
}

enum AlertSeverity {
  WATCH
  WARNING
  EMERGENCY
}

enum ReportStatus {
  PENDING
  VERIFIED
  REJECTED
  RESOLVED
}

enum BoreholeStatus {
  FUNCTIONAL
  DRY
  ABANDONED
}

enum HydroEventType {
  FLASH_FLOOD
  DROUGHT
}

enum ReportSource {
  MOBILE_APP
  OFFLINE_SYNC
  IVR
  WHATSAPP
}

enum MaintenanceTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum CropWaterDemand {
  LOW
  MEDIUM
  HIGH
}

enum MarketTrend {
  RISING
  STABLE
  FALLING
}

enum WaterPointStatus {
  RELIABLE
  STRESSED
  DRY
  CONTAMINATED
}

enum WaterSourceType {
  BOREHOLE
  WATER_POINT
  RIVER
  RESERVOIR
}

enum SourceStatus {
  ACTIVE
  DRY
  UNDER_REPAIR
  ABANDONED
}

enum AlertType {
  HIGH_DROUGHT_RISK
  LOW_WATER_LEVELS
  RAINFALL_DEFICIT
  SENSOR_OFFLINE
  COMMUNITY_REPORT
}

enum MessagingChannel {
  WHATSAPP
  IVR
}

enum ConversationState {
  STARTED
  AWAITING_WATER_LEVEL
  AWAITING_DESCRIPTION
  AWAITING_LOCATION
  COMPLETED
  CANCELLED
}

enum UploadProvider {
  LOCAL
  S3
  GCS
  AZURE
}

enum UploadScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
}

enum MarketImportStatus {
  SUCCESS
  FAILED
}

model Tenant {
  id            String                  @id @default(uuid()) @db.Uuid
  name          String
  slug          String                  @unique
  country       String
  billingPlan   String                  @default("starter")
  config        Json?
  createdAt     DateTime                @default(now())
  users         User[]
  districts     District[]
  apiKeys       ApiKey[]
  simulations   DigitalTwinSimulation[]
  cropVarieties CropVariety[]
  marketPrices  MarketPrice[]
  conflictRisks ConflictRiskArea[]
  conversations MessagingConversation[]
  uploadAssets  UploadAsset[]
  marketImports MarketImportRun[]
  sensorDevices SensorDevice[]
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String?            @db.Uuid
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name              String
  email             String             @unique
  passwordHash      String
  role              UserRole           @default(community_user)
  adminScope        AdminScope?
  status            UserStatus         @default(ACTIVE)
  tokenVersion      Int                @default(0)
  district          String?
  points            Int                @default(0)
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  communityReports  CommunityReport[]
  moderationActions ReportModeration[]
  aois              Aoi[]
  refreshTokens     RefreshToken[]

  @@index([tenantId])
  @@index([tenantId, status, createdAt])
  @@index([role])
  @@index([adminScope])
  @@index([status])
  @@index([district])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt, expiresAt])
}

model Aoi {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  geometry  Json
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  creator   User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdBy])
  @@map("aois")
}

model District {
  id                   String                                 @id @default(uuid()) @db.Uuid
  tenantId             String?                                @db.Uuid
  tenant               Tenant?                                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name                 String                                 @unique
  geometry             Unsupported("geometry(Polygon, 4326)")
  droughtRiskLevel     DroughtRiskLevel                       @default(NORMAL)
  createdAt            DateTime                               @default(now())
  sensors              Sensor[]
  satelliteIndexes     SatelliteIndex[]
  droughtAlerts        DroughtAlert[]
  communityReports     CommunityReport[]
  droughtForecasts     DroughtForecast[]
  droughtSnapshots     DroughtSnapshot[]
  boreholes            Borehole[]
  waterSources         WaterSource[]
  ndviReadings         NDVIReading[]
  rainfallRecords      RainfallRecord[]
  hydroEvents          HydroEvent[]
  irrigationSchedules  IrrigationSchedule[]
  cropRecommendations  CropRecommendation[]
  livestockWaterPoints LivestockWaterPoint[]
  pastureConditions    PastureCondition[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([droughtRiskLevel])
}

model IrrigationSchedule {
  id                      String        @id @default(uuid()) @db.Uuid
  districtId              String        @db.Uuid
  district                District      @relation(fields: [districtId], references: [id], onDelete: Cascade)
  cropName                String
  soilMoisturePercent     Float
  evapotranspirationMmDay Float
  recommendedDate         DateTime
  waterMm                 Float
  litersPerHectare        Float
  priority                AlertSeverity
  rationale               String
  createdAt               DateTime      @default(now())

  @@index([districtId, recommendedDate])
}

model CropVariety {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String?              @db.Uuid
  tenant           Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  cropName         String
  varietyName      String
  season           String
  waterDemand      CropWaterDemand
  droughtTolerance Int
  maturityDays     Int
  notes            String
  recommendations  CropRecommendation[]

  @@index([tenantId, cropName])
  @@index([waterDemand, droughtTolerance])
}

model CropRecommendation {
  id            String      @id @default(uuid()) @db.Uuid
  districtId    String      @db.Uuid
  district      District    @relation(fields: [districtId], references: [id], onDelete: Cascade)
  cropVarietyId String      @db.Uuid
  cropVariety   CropVariety @relation(fields: [cropVarietyId], references: [id], onDelete: Cascade)
  score         Float
  rationale     String
  season        String
  createdAt     DateTime    @default(now())

  @@index([districtId, score])
}

model MarketPrice {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String?     @db.Uuid
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  commodity    String
  marketName   String
  unit         String
  price        Float
  currency     String      @default("KES")
  observedAt   DateTime
  trend        MarketTrend @default(STABLE)
  source       String
  decisionHint String

  @@index([tenantId, commodity, observedAt])
}

model LivestockWaterPoint {
  id                 String                               @id @default(uuid()) @db.Uuid
  districtId         String                               @db.Uuid
  district           District                             @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name               String
  location           Unsupported("geometry(Point, 4326)")
  status             WaterPointStatus
  waterVolumeLiters  Float
  dailyDemandLiters  Float
  daysRemaining      Float
  supportedLivestock Int
  lastUpdatedAt      DateTime                             @default(now())

  @@index([districtId, status])
}

model PastureCondition {
  id              String           @id @default(uuid()) @db.Uuid
  districtId      String           @db.Uuid
  district        District         @relation(fields: [districtId], references: [id], onDelete: Cascade)
  pastureIndex    Float
  grazingPressure Float
  stressLevel     DroughtRiskLevel
  observedAt      DateTime
  notes           String

  @@index([districtId, observedAt])
}

model DroughtSnapshot {
  id                     String           @id @default(uuid()) @db.Uuid
  districtId             String           @db.Uuid
  district               District         @relation(fields: [districtId], references: [id], onDelete: Cascade)
  weekStart              DateTime
  severityScore          Float
  riskLevel              DroughtRiskLevel
  groundwaterDepthMeters Float
  rainfallAnomalyPercent Float
  ndvi                   Float

  @@index([districtId, weekStart])
  @@index([riskLevel])
}

model Borehole {
  id                 String                               @id @default(uuid()) @db.Uuid
  name               String
  location           Unsupported("geometry(Point, 4326)")
  districtId         String                               @db.Uuid
  district           District                             @relation(fields: [districtId], references: [id], onDelete: Cascade)
  depthMeters        Float
  yieldLitersPerHour Float
  status             BoreholeStatus
  lastInspectedAt    DateTime?

  @@index([districtId, status])
}

model ConflictRiskArea {
  id                String                                 @id @default(uuid()) @db.Uuid
  tenantId          String?                                @db.Uuid
  tenant            Tenant?                                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name              String
  geometry          Unsupported("geometry(Polygon, 4326)")
  riskScore         Float
  incidentsLastYear Int
  notes             String
  updatedAt         DateTime                               @default(now())

  @@index([tenantId])
  @@index([riskScore])
}

model HydroEvent {
  id         String                                 @id @default(uuid()) @db.Uuid
  districtId String                                 @db.Uuid
  district   District                               @relation(fields: [districtId], references: [id], onDelete: Cascade)
  eventType  HydroEventType
  severity   DroughtRiskLevel
  eventDate  DateTime
  geometry   Unsupported("geometry(Polygon, 4326)")
  notes      String

  @@index([districtId, eventType, eventDate])
}

model Sensor {
  id                 String                               @id @default(uuid()) @db.Uuid
  type               SensorType
  location           Unsupported("geometry(Point, 4326)")
  districtId         String                               @db.Uuid
  district           District                             @relation(fields: [districtId], references: [id], onDelete: Cascade)
  status             SensorStatus                         @default(ONLINE)
  lastPing           DateTime?
  createdAt          DateTime                             @default(now())
  readings           SensorReading[]
  maintenanceTickets MaintenanceTicket[]
  device             SensorDevice?

  @@index([type])
  @@index([districtId])
  @@index([districtId, status, lastPing])
  @@index([districtId, createdAt])
  @@index([status])
}

model SensorDevice {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String?   @db.Uuid
  tenant            Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  sensorId          String    @unique @db.Uuid
  sensor            Sensor    @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  externalId        String
  authTokenHash     String
  provider          String    @default("generic_http")
  pollUrl           String?
  metadata          Json?
  lastAuthenticated DateTime?
  createdAt         DateTime  @default(now())

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([provider])
}

model MaintenanceTicket {
  id          String                  @id @default(uuid()) @db.Uuid
  sensorId    String                  @db.Uuid
  sensor      Sensor                  @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  districtId  String                  @db.Uuid
  title       String
  description String
  priority    MaintenancePriority     @default(MEDIUM)
  status      MaintenanceTicketStatus @default(OPEN)
  staleHours  Float
  assignedTo  String?
  createdAt   DateTime                @default(now())
  resolvedAt  DateTime?

  @@index([sensorId, status])
  @@index([districtId, status])
  @@index([districtId, status, createdAt])
}

model DigitalTwinSimulation {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String?          @db.Uuid
  tenant                 Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  districtId             String           @db.Uuid
  scenarioName           String
  rainfallDropPercent    Float
  durationWeeks          Int
  baselineGroundwater    Float
  projectedGroundwater   Float
  projectedSeverityScore Float
  projectedRiskLevel     DroughtRiskLevel
  assumptions            Json
  createdAt              DateTime         @default(now())

  @@index([tenantId, districtId, createdAt])
}

model ApiKey {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String?      @db.Uuid
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  name         String
  keyHash      String       @unique
  keyPrefix    String
  ownerEmail   String
  quotaPerHour Int          @default(100)
  status       ApiKeyStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  lastUsedAt   DateTime?
  usages       ApiUsage[]

  @@index([tenantId, status])
  @@index([tenantId, status, createdAt])
}

model ApiUsage {
  id       String   @id @default(uuid()) @db.Uuid
  apiKeyId String   @db.Uuid
  apiKey   ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  route    String
  usedAt   DateTime @default(now())

  @@index([apiKeyId, usedAt])
}

model SensorReading {
  id        String   @id @default(uuid()) @db.Uuid
  sensorId  String   @db.Uuid
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  value     Float
  unit      String
  timestamp DateTime @default(now())
  metadata  Json?

  @@index([sensorId, timestamp])
}

model WaterSource {
  id              String                               @id @default(uuid()) @db.Uuid
  name            String
  type            WaterSourceType
  location        Unsupported("geometry(Point, 4326)")
  districtId      String                               @db.Uuid
  district        District                             @relation(fields: [districtId], references: [id], onDelete: Cascade)
  status          SourceStatus                         @default(ACTIVE)
  depth           Float?
  yield           Float?
  lastInspected   DateTime?
  inspectionNotes String?
  createdAt       DateTime                             @default(now())
  readings        WaterSourceReading[]

  @@index([districtId, type])
  @@index([districtId, status, createdAt])
  @@index([status])
}

model WaterSourceReading {
  id         String      @id @default(uuid()) @db.Uuid
  sourceId   String      @db.Uuid
  source     WaterSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  waterLevel Float
  turbidity  Float?
  ph         Float?
  timestamp  DateTime    @default(now())

  @@index([sourceId, timestamp])
}

model NDVIReading {
  id         String   @id @default(uuid()) @db.Uuid
  districtId String   @db.Uuid
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  value      Float
  capturedAt DateTime
  source     String   @default("Sentinel-2")

  @@index([districtId, capturedAt])
}

model RainfallRecord {
  id         String   @id @default(uuid()) @db.Uuid
  districtId String   @db.Uuid
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  month      String
  mmTotal    Float
  source     String   @default("CHIRPS")

  @@unique([districtId, month, source])
  @@index([districtId, month])
}

model SatelliteIndex {
  id         String             @id @default(uuid()) @db.Uuid
  districtId String             @db.Uuid
  district   District           @relation(fields: [districtId], references: [id], onDelete: Cascade)
  indexType  SatelliteIndexType
  value      Float
  capturedAt DateTime
  geoTiff    String?

  @@index([districtId, indexType, capturedAt])
}

model DroughtAlert {
  id          String        @id @default(uuid()) @db.Uuid
  districtId  String        @db.Uuid
  district    District      @relation(fields: [districtId], references: [id], onDelete: Cascade)
  alertType   AlertType     @default(HIGH_DROUGHT_RISK)
  severity    AlertSeverity
  subDistrict String?
  message     String
  triggeredAt DateTime      @default(now())
  resolvedAt  DateTime?

  @@index([districtId, resolvedAt])
  @@index([districtId, severity, triggeredAt])
  @@index([alertType])
  @@index([severity])
}

model CommunityReport {
  id                    String                               @id @default(uuid()) @db.Uuid
  userId                String                               @db.Uuid
  user                  User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  districtId            String?                              @db.Uuid
  district              District?                            @relation(fields: [districtId], references: [id], onDelete: SetNull)
  location              Unsupported("geometry(Point, 4326)")
  waterLevel            Float
  description           String
  photoUrl              String?
  photoMetadata         Json?
  gpsAccuracyMeters     Float?
  source                ReportSource                         @default(MOBILE_APP)
  externalReporterPhone String?
  status                ReportStatus                         @default(PENDING)
  createdAt             DateTime                             @default(now())
  moderationActions     ReportModeration[]
  uploadAssets          UploadAsset[]

  @@index([userId])
  @@index([districtId, status])
  @@index([districtId, status, createdAt])
}

model ReportModeration {
  id          String          @id @default(uuid()) @db.Uuid
  reportId    String          @db.Uuid
  report      CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  moderatorId String?         @db.Uuid
  moderator   User?           @relation(fields: [moderatorId], references: [id], onDelete: SetNull)
  action      ReportStatus
  notes       String?
  createdAt   DateTime        @default(now())

  @@index([reportId, createdAt])
  @@index([moderatorId])
}

model MessagingConversation {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String?           @db.Uuid
  tenant        Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  channel       MessagingChannel
  provider      String
  externalId    String
  phone         String
  state         ConversationState @default(STARTED)
  payload       Json?
  reportId      String?           @db.Uuid
  lastMessageAt DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@unique([channel, provider, externalId])
  @@index([tenantId, channel, state])
  @@index([phone, lastMessageAt])
}

model UploadAsset {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String?          @db.Uuid
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  reportId        String?          @db.Uuid
  report          CommunityReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  provider        UploadProvider
  bucket          String?
  objectKey       String
  publicUrl       String?
  signedUrl       String?
  mimeType        String
  byteSize        Int
  checksumSha256  String
  scanStatus      UploadScanStatus @default(PENDING)
  moderationLabel String?
  moderationScore Float?
  metadata        Json?
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@index([reportId])
  @@index([scanStatus])
}

model MarketImportRun {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String?            @db.Uuid
  tenant        Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  provider      String
  status        MarketImportStatus
  importedCount Int                @default(0)
  errorMessage  String?
  startedAt     DateTime           @default(now())
  completedAt   DateTime?

  @@index([tenantId, provider, startedAt])
}

model DroughtForecast {
  id                String                  @id @default(uuid()) @db.Uuid
  districtId        String                  @db.Uuid
  district          District                @relation(fields: [districtId], references: [id], onDelete: Cascade)
  forecastDate      DateTime
  predictedSeverity DroughtRiskLevel
  confidenceScore   Float
  riskScore         Float                   @default(0.5)
  riskLabel         String                  @default("Moderate")
  recommendation    Json?
  modelVersion      String
  drivers           DroughtForecastDriver[]

  @@index([districtId, forecastDate])
}

model DroughtForecastDriver {
  id         String          @id @default(uuid()) @db.Uuid
  forecastId String          @db.Uuid
  forecast   DroughtForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  factor     String
  direction  String
  impact     String

  @@index([forecastId])
}
