SERVER_IMAGE=registry.example.com/smart-water-map/server:COMMIT_SHA
CLIENT_IMAGE=registry.example.com/smart-water-map/client:COMMIT_SHA
CLIENT_ORIGIN=https://water.example.com
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?schema=public
SERVER_BIND=127.0.0.1:4001
CLIENT_BIND=127.0.0.1:5174
POSTGRES_DB=smart_water_map
POSTGRES_USER=smart_water
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=25
PGBOUNCER_RESERVE_POOL_SIZE=10
S3_BUCKET=smart-water-map-prod
S3_REGION=us-east-1
UPLOAD_PROVIDER=s3
AFRICASTALKING_USERNAME=production
